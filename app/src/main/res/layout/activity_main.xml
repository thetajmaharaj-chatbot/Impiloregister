<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="IMPILO DRILLING" android:textStyle="bold" android:textSize="13sp" android:letterSpacing=".12" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Staff Register" android:textStyle="bold" android:textSize="30sp" android:layout_marginBottom="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="STAFF MEMBER" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/staffSpinner" android:background="@android:drawable/editbox_background" android:padding="10dp" android:layout_width="match_parent" android:layout_height="56dp"/>
<LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/addStaff" android:text="+ Add" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<Button android:id="@+id/editStaff" android:text="Edit" android:layout_marginStart="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<Button android:id="@+id/deleteStaff" android:text="Delete" android:layout_marginStart="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
</LinearLayout>
<CalendarView android:id="@+id/calendar" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/dateLabel" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/note" android:hint="Write notes for this day..." android:gravity="top|start" android:padding="14dp" android:minLines="5" android:background="@android:drawable/edit_text" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/saveNote" android:text="SAVE NOTE" android:layout_marginTop="10dp" android:layout_marginBottom="20dp" android:layout_width="match_parent" android:layout_height="54dp"/>
</LinearLayout></ScrollView>